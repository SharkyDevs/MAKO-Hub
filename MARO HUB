local function foodAll()
    if FoodsConfig and FoodsConfig.GetAny then
        local ok, n = pcall(function() return FoodsConfig.CountAll() end)
        if ok and type(n) == "number" then return n end
    end
    return 45
end

local function foodInfo(i)
    if FoodsConfig and FoodsConfig.GetAny then
        local ok, v = pcall(function() return FoodsConfig.GetAny(i) end)
        if ok and type(v) == "table" then return v end
    end
end

local function foodLocked(i)
    if FoodsConfig and FoodsConfig.IsLocked then
        local ok, v = pcall(function() return FoodsConfig.IsLocked(i) end)
        if ok then return v end
    end
    return false
end

local function foodName(i)
    local info = foodInfo(i)
    return info and info.Name or ("Food " .. i)
end

local function isOwned(i)
    if ownedFoods[i] then return true end
    if DataController and DataController.GetPath then
        local ok, v = pcall(function() return DataController:GetPath("OwnedFoods." .. i) end)
        if ok and v == true then ownedFoods[i] = true return true end
    end
    return false
end

local function highestOwned()
    local hi = 0
    for i = 1, foodAll() do
        if isOwned(i) and i > hi then hi = i end
    end
    return hi
end

local function nextFood()
    for i = highestOwned() + 1, foodAll() do
        if not foodLocked(i) then return i end
    end
end

local function buyNextPass()
    if busy() then return end
    local i = nextFood()
    if not i then return end
    local info = foodInfo(i)
    local price = info and tonumber(info.Price)
    if not price then return end

    local money, known = getMoney()
    if known and money < price then return end

    if okRes(invoke("Shop_Buy", i)) then
        ownedFoods[i] = true
        invoke("Shop_Equip", i)
        notify("Shop", "Bought and equipped " .. (info.Name or ("Food " .. i)), 3)
    end
end

