local function L(t, n) return t.AddLeftGroupbox and t:AddLeftGroupbox(n) or t:AddGroupbox(n) end
local function Rg(t, n) return t.AddRightGroupbox and t:AddRightGroupbox(n) or t:AddGroupbox(n) end

local function toggle(b, id, text, def, cb, tip)
    local cfg = {Text=text, Name=text, Default=def, Tooltip=tip, Callback=cb}
    if not pcall(function() b:AddToggle(id, cfg) end) then pcall(function() b:AddToggle(cfg) end) end
end
local function slider(b, id, text, def, mn, mx, rd, cb)
    local cfg = {Text=text, Name=text, Default=def, Min=mn, Max=mx, Rounding=rd, Callback=cb}
    if not pcall(function() b:AddSlider(id, cfg) end) then pcall(function() b:AddSlider(cfg) end) end
end
local function button(b, text, cb)
    local cfg = {Text=text, Name=text, Func=cb}
    if not pcall(function() b:AddButton(text, cfg) end) then pcall(function() b:AddButton(cfg) end) end
end
local function input(b, id, text, def, cb)
    local cfg = {Text=text, Name=text, Default=def, Finished=true, Callback=cb}
    if not pcall(function() b:AddInput(id, cfg) end) then pcall(function() b:AddInput(cfg) end) end
end
local function dropdown(b, id, text, vals, def, cb)
    local cfg = {Text=text, Name=text, Values=vals, Default=def, Callback=cb}
    local ok, obj
    ok = pcall(function() obj = b:AddDropdown(id, cfg) end)
    if not ok then pcall(function() obj = b:AddDropdown(cfg) end) end
    return obj
end
local function label(b, t) if b.AddLabel then pcall(function() b:AddLabel(t) end) end end
local function divider(b) if b.AddDivider then pcall(function() b:AddDivider() end) end end

