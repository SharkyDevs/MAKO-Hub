    if type(setthreadidentity) == "function" then
        for _, id in ipairs({2, 7, 8}) do
            pcall(setthreadidentity, id)
            ok, v = pcall(require, inst)
            if ok then break end
        end
        pcall(setthreadidentity, prev or 8)
    else
        ok, v = pcall(require, inst)
    end
    if ok then return v end
end

