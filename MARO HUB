local petMap = {}
local seenIds = {}

local function addPet(display, id)
    if not id or seenIds[tostring(id)] then return end
    seenIds[tostring(id)] = true
    local uniq, n = display, 2
    while petMap[uniq] do uniq = display .. " (" .. n .. ")" n = n + 1 end
    petMap[uniq] = id
end

local function idFrom(inst)
    for _, a in ipairs({"AnimalId","Animal","Id","UID","PetId","Id_"}) do
        local v = inst:GetAttribute(a)
        if v ~= nil then return v end
    end
end

local function buildPetList()
    petMap = {}
    seenIds = {}

    local animals
    if DataController and DataController.Get then
        local ok, v = pcall(function() return DataController:Get("Animals") end)
        if ok then animals = v end
    end
    if type(animals) == "table" then
        for id, e in pairs(animals) do
            if type(e) == "table" then
                local nm = e.ModelName or e.Name or e.name
                if nm then addPet(tostring(nm) .. (e.Placed and "  [Placed]" or "  [Backpack]"), id) end
            end
        end
    end

    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") then
                local id = idFrom(t)
                if id then addPet((t:GetAttribute("ModelName") or t.Name) .. "  [Backpack]", id) end
            end
        end
    end

    local ch = LocalPlayer.Character
    if ch then
        for _, t in ipairs(ch:GetChildren()) do
            if t:IsA("Tool") then
                local id = idFrom(t)
                if id then addPet((t:GetAttribute("ModelName") or t.Name) .. "  [Equipped]", id) end
            end
        end
    end

    local props = workspace:FindFirstChild("LocalPlotProps")
    if props then
        for _, d in ipairs(props:GetDescendants()) do
            if d:IsA("Model") then
                local id = idFrom(d)
                if id then addPet(d.Name .. "  [Plot]", id) end
            end
        end
    end

    local out = {}
    for k in pairs(petMap) do out[#out + 1] = k end
    table.sort(out)
    if #out == 0 then out = { "No pets found" } end
    return out
end

