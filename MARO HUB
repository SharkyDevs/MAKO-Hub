local EXPIRY_FILE = "MakoHub_discord_expiry.txt"
local expiry = 0

local function loadExpiry()
    local ok, raw = pcall(function() return readfile(EXPIRY_FILE) end)
    if ok and raw then
        local n = tonumber(raw)
        if n and n > 0 then expiry = n return end
    end
    expiry = os.time() + LINK_LIFE
    pcall(function() writefile(EXPIRY_FILE, tostring(expiry)) end)
end

local function timeLeft() return expiry - os.time() end

local function expiryText()
    local left = timeLeft()
    if left <= 0 then return "Expired" end
    local d = math.floor(left / 86400)
    local h = math.floor((left % 86400) / 3600)
    if d > 0 then return d .. "d " .. h .. "h left" end
    return h .. "h " .. math.floor((left % 3600) / 60) .. "m left"
end

