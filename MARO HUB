local SUF = { K=1e3,M=1e6,B=1e9,T=1e12,Qa=1e15,Qi=1e18,Sx=1e21,Sp=1e24,
              Oc=1e27,No=1e30,Dc=1e33,Ud=1e36,Dd=1e39 }

local function parseMoney(v)
    if type(v) == "number" then return v end
    if type(v) ~= "string" then return 0 end
    v = v:gsub("[%s,]", "")
    local n, s = v:match("^([%d%.eE%+%-]+)(%a*)$")
    if n then
        local num = tonumber(n) or 0
        if s ~= "" and SUF[s] then return num * SUF[s] end
        return num
    end
    return tonumber(v) or 0
end

local moneyLabel

local function findMoneyLabel()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextLabel") and (d.Name:lower():find("money") or d.Name:lower():find("cash")) then
            return d
        end
