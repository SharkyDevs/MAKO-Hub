local function getMoney()
    if DataController and DataController.Get then
        for _, k in ipairs({"Money", "Cash", "Coins"}) do
            local ok, v = pcall(function() return DataController:Get(k) end)
            if ok and type(v) == "number" then return v, true end
        end
        if DataController.GetPath then
            local ok, v = pcall(function() return DataController:GetPath("Money") end)
            if ok and type(v) == "number" then return v, true end
        end
    end
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if ls then
        for _, c in ipairs(ls:GetChildren()) do
            if c:IsA("ValueBase") and type(c.Value) == "number" then
                local n = c.Name:lower()
                if n:find("money") or n:find("cash") or n:find("coin") then
                    return c.Value, true
                end
            end
        end
    end
    if not moneyLabel or not moneyLabel.Parent then moneyLabel = findMoneyLabel() end
    if moneyLabel and moneyLabel.Text:find("%d") then
        return parseMoney(moneyLabel.Text), true
    end
    return 0, false
end

