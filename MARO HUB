        pcall(function() settings().Rendering.MeshPartDetailLevel = fpsSaved.m end)
        Lighting.GlobalShadows = true
        Lighting.FogEnd = 100000
        task.spawn(function()
            local n = 0
            for k, v in pairs(fpsSaved) do
                if typeof(k) == "Instance" and k.Parent then
                    if type(v) == "boolean" then pcall(function() k.Enabled = v end)
                    elseif v.t == "tr" then pcall(function() k.Transparency = v.v end)
                    elseif v.t == "tex" then pcall(function() k.TextureID = v.v end)
                    elseif v.t == "mat" then pcall(function() k.Material = v.v end) end
                end
                n = n + 1
                if n % 150 == 0 then task.wait() end
            end
        end)
        fpsSaved = {}
    end
end

local rejoinOn = false
local function setAntiKick(on)
    rejoinOn = on
    if not on then return end
    task.spawn(function()
        while rejoinOn and not unloaded do
            task.wait(1)
            if S.antiKick then
                local lp = Players.LocalPlayer
                if not lp or not lp.Parent or not lp:FindFirstChild("PlayerGui") then
                    notify("Auto Rejoin", "Kicked. Rejoining...", 5)
                    pcall(function() TeleportService:Teleport(PLACE_ID) end)
                    task.wait(5)
                end
            end
        end
    end)
    pcall(function()
        game:GetService("GuiService").ErrorMessageChanged:Connect(function()
            if S.antiKick and not unloaded then
                task.wait(1)
                pcall(function() TeleportService:Teleport(PLACE_ID) end)
            end
        end)
    end)
end

--=====================================================================
-- UI HELPERS
