--=====================================================================
local function readLvl(keys, fb)
    if DataController and DataController.Get then
        for _, k in ipairs(keys) do
            local ok, v = pcall(function() return DataController:Get(k) end)
            if ok and type(v) == "number" then return v end
        end
    end
    return fb
end

local POOR = {
    NotEnoughMoney = true, InsufficientFunds = true, Poor = true,
    NotEnoughCash = true, NoMoney = true, CantAfford = true,
}

local function upgradePass(key, remote, prices, keys, ref)
    if os.clock() < upBackoff[key] then return end
    local lvl = readLvl(keys, ref.value)

    for _ = 1, 8 do
        local price = prices[lvl + 1]
        if not price then return end

        local money, known = getMoney()
        if known and money < price then
            upBackoff[key] = os.clock() + 0.5
            return
        end

        local res = invoke(remote)
        if okRes(res) then
            lvl = lvl + 1
            ref.value = lvl
            upBackoff[key] = 0
        else
            local reason = type(res) == "table" and res.Reason or ""
            if POOR[reason] then
                upBackoff[key] = os.clock() + 0.8
            else
                upBackoff[key] = os.clock() + 0.3
            end
            return
        end
    end
end

local function startUpgrade(key, remote, prices, keys, ref)
    if R[key] then return end
    if not hasRemote(remote) then notify("Upgrade", remote .. " missing", 4) return end
    R[key] = true
    task.spawn(function()
        while S[key] and not unloaded do
            pcall(upgradePass, key, remote, prices, keys, ref)
            task.wait(S.upgradeDelay)
        end
        R[key] = false
    end)
end

