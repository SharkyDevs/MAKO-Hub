local function readLvl(keys, fb)
    if DataController and DataController.Get then
        for _, k in ipairs(keys) do
            local ok, v = pcall(function() return DataController:Get(k) end)
            if ok and type(v) == "number" then return v end
        end
    end
    return fb
end

local function partsFor()
    if os.clock() - partCache.at < 3 and (partCache.stand or partCache.fence) then return end
    partCache.at = os.clock()
    partCache.stand, partCache.fence = nil, nil
    local props = workspace:FindFirstChild("LocalPlotProps")
    if not props then return end
    for _, d in ipairs(props:GetDescendants()) do
        if d:IsA("BasePart") then
            local low = d.Name:lower()
            if not partCache.stand and (low:find("stand") or low:find("pull")) then partCache.stand = d
            elseif not partCache.fence and (low:find("fence") or low:find("sign")) then partCache.fence = d end
        end
        if partCache.stand and partCache.fence then break end
    end
end

local function approach(part)
    local hrp = root()
    if not part or not hrp then return end
    if (hrp.Position - part.Position).Magnitude < 16 then return end
    if os.clock() - lastApproach < 1.5 then return end
    lastApproach = os.clock()
    hrp.CFrame = part.CFrame + Vector3.new(0, 4, 0)
    task.wait(0.15)
end

local POOR = {
    NotEnoughMoney = true, InsufficientFunds = true, Poor = true,
    NotEnoughCash = true, NoMoney = true, CantAfford = true, NeedMoreMoney = true,
}

local function upgradePass(cacheKey, remote, prices, keys, ref)
    if os.clock() < upBackoff[cacheKey] then return end
    local lvl = readLvl(keys, ref.value)
    for _ = 1, 6 do
        local price = prices[lvl + 1]
        if not price then return end
        local money, known = getMoney()
        if known and money < price then upBackoff[cacheKey] = os.clock() + 0.5 return end
        partsFor()
        approach(partCache[cacheKey])
        local res = invoke(remote)
        if okRes(res) then
            lvl = lvl + 1
            ref.value = lvl
            upBackoff[cacheKey] = 0
        else
            local reason = type(res) == "table" and res.Reason or ""
            upBackoff[cacheKey] = POOR[reason] and (os.clock() + 0.8) or (os.clock() + 0.35)
            return
        end
    end
end

local function startUpgrade(stateKey, cacheKey, remote, prices, keys, ref)
    if R[cacheKey] then return end
    if not hasRemote(remote) then notify("Upgrade", remote .. " missing", 4) return end
    R[cacheKey] = true
    task.spawn(function()
        while S[stateKey] and not unloaded do
            pcall(upgradePass, cacheKey, remote, prices, keys, ref)
            task.wait(S.upgradeDelay)
        end
        R[cacheKey] = false
    end)
end

