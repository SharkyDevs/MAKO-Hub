local fpsSaved = {}
local function setFps(on)
    if on then
        pcall(function()
            fpsSaved.q = settings().Rendering.QualityLevel
            fpsSaved.m = settings().Rendering.MeshPartDetailLevel
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01
        end)
        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 1e7
        end)
        pcall(function()
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("PostEffect") then fpsSaved[v] = v.Enabled v.Enabled = false end
            end
        end)
        task.spawn(function()
            local n = 0
            for _, d in ipairs(workspace:GetDescendants()) do
                pcall(function()
                    if d:IsA("SurfaceAppearance") then
                        fpsSaved[d] = { t = "spa", v = d.Parent } d.Parent = nil
                    elseif d:IsA("Decal") or d:IsA("Texture") then
                        fpsSaved[d] = { t = "tr", v = d.Transparency } d.Transparency = 1
                    elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") then
                        fpsSaved[d] = { t = "en", v = d.Enabled } d.Enabled = false
                    elseif d:IsA("MeshPart") and d.TextureID ~= "" then
                        fpsSaved[d] = { t = "tex", v = d.TextureID } d.TextureID = ""
                    elseif d:IsA("BasePart") then
                        fpsSaved[d] = { t = "mat", v = d.Material } d.Material = Enum.Material.SmoothPlastic
                    end
                end)
                n = n + 1
                if n % 200 == 0 then task.wait() end
            end
        end)
    else
        pcall(function()
            if fpsSaved.q then settings().Rendering.QualityLevel = fpsSaved.q end
            if fpsSaved.m then settings().Rendering.MeshPartDetailLevel = fpsSaved.m end
        end)
        pcall(function()
            Lighting.GlobalShadows = true
            Lighting.FogEnd = 100000
        end)
        task.spawn(function()
            local n = 0
            for k, v in pairs(fpsSaved) do
                if typeof(k) == "Instance" then
                    pcall(function()
                        if type(v) == "boolean" then k.Enabled = v
                        elseif v.t == "tr" then k.Transparency = v.v
                        elseif v.t == "tex" then k.TextureID = v.v
                        elseif v.t == "mat" then k.Material = v.v
                        elseif v.t == "spa" and v.v then k.Parent = v.v end
                    end)
                end
                n = n + 1
                if n % 200 == 0 then task.wait() end
            end
        end)
        fpsSaved = {}
    end
end

