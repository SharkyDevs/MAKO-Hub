local meterOrig = {}

local function runPerfect()
    return 1.0, { Text = "PERFECT!", Color = Color3.fromRGB(120, 255, 140) }, 20
end

local function installPerfect()
    if not ThrowMeter or meterOrig.done then return end
    meterOrig.done = true
    if type(ThrowMeter.new) == "function" then
        meterOrig.new = ThrowMeter.new
        ThrowMeter.new = function(...)
            local inst = meterOrig.new(...)
            if type(inst) == "table" then inst.Run = runPerfect end
            return inst
        end
    end
    local idx = ThrowMeter.__index
    if type(idx) == "table" and type(idx.Run) == "function" then
        meterOrig.idxRun = idx.Run
        idx.Run = runPerfect
    end
    if type(ThrowMeter.Run) == "function" then
        meterOrig.run = ThrowMeter.Run
        ThrowMeter.Run = runPerfect
    end
end

local function uninstallPerfect()
    if not ThrowMeter or not meterOrig.done then return end
    if meterOrig.new then ThrowMeter.new = meterOrig.new end
    local idx = ThrowMeter.__index
    if idx and meterOrig.idxRun then idx.Run = meterOrig.idxRun end
    if meterOrig.run then ThrowMeter.Run = meterOrig.run end
    meterOrig.done = false
    meterOrig.new, meterOrig.idxRun, meterOrig.run = nil, nil, nil
end

