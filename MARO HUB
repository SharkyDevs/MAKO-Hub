local function toggle(b, id, text, def, cb, tip)
    if not b then return end
    local cfg = {Text=text, Name=text, Default=def, Tooltip=tip, Callback=cb or function() end}
    if not pcall(function() b:AddToggle(id, cfg) end) then pcall(function() b:AddToggle(cfg) end) end
end
local function slider(b, id, text, def, mn, mx, rd, cb)
    if not b then return end
    local cfg = {Text=text, Name=text, Default=def, Min=mn, Max=mx, Rounding=rd, Callback=cb or function() end}
    if not pcall(function() b:AddSlider(id, cfg) end) then pcall(function() b:AddSlider(cfg) end) end
end
local function button(b, text, cb)
    if not b then return end
    local cfg = {Text=text, Name=text, Func=cb or function() end}
    if not pcall(function() b:AddButton(text, cfg) end) then pcall(function() b:AddButton(cfg) end) end
end
local function dropdown(b, id, text, vals, def, cb)
    if not b then return nil end
    local cfg = {Text=text, Name=text, Values=vals, Default=def, Callback=cb or function() end}
    local ok, obj
    ok = pcall(function() obj = b:AddDropdown(id, cfg) end)
    if not ok then pcall(function() obj = b:AddDropdown(cfg) end) end
    return obj
end
local function label(b, t) if b and b.AddLabel then pcall(function() b:AddLabel(t) end) end end
local function divider(b) if b and b.AddDivider then pcall(function() b:AddDivider() end) end end

local KEYS = {"Frame","Text","Label","Element","Object","Container","Root","Holder","Box","Group"}
local function findInst(obj)
    if typeof(obj) == "Instance" then return obj end
    for _, k in ipairs(KEYS) do
        local ok, v = pcall(function() return obj[k] end)
        if ok and typeof(v) == "Instance" then return v end
    end
end

local function containerOf(b)
    if not b then return nil end
    local ok, lbl = pcall(function() return b:AddLabel(" ") end)
    if ok and lbl then
        local inst = findInst(lbl)
        if inst and inst.Parent then return inst.Parent end
    end
    local gi = findInst(b)
    if gi then return gi end
end

