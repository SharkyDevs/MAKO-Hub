local function groundUnder(pos, ignore)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = ignore
    local hit = workspace:Raycast(pos + Vector3.new(0, 50, 0), Vector3.new(0, -300, 0), params)
    return hit and hit.Position or nil
end

local function crossLine()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return false end
    local area = workspace:FindFirstChild("StarterArea")
    local line = area and area:FindFirstChild("CrossLine")
    if not line then return false end
    if hum.SeatPart then pcall(function() hum.Sit = false end) task.wait(0.15) end
    local halfX = area.Size.X / 2
    local x = math.clamp(laneX or hrp.Position.X, area.Position.X - halfX + 2, area.Position.X + halfX - 2)
    local z = line.Position.Z - 1.5
    local ground = groundUnder(Vector3.new(x, area.Position.Y + area.Size.Y / 2, z), { char })
    if not ground then return false end
    local pos = ground + Vector3.new(0, hum.HipHeight + hrp.Size.Y / 2 + 0.1, 0)
    char:PivotTo(CFrame.lookAt(pos, pos + Vector3.new(0, 0, -1)))
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    return true
end

local function throwLoop()
    while S.autoThrow and not unloaded do
        local t0 = os.clock()
        while S.autoThrow and busy() and os.clock() - t0 < 30 do task.wait(0.2) end
        if not S.autoThrow then break end

        local started = false
        for _ = 1, 4 do
            if not S.autoThrow then break end
            crossLine()
            local t1 = os.clock()
            while os.clock() - t1 < 3 do
                if ClientState and ClientState.Busy == "Throw" then started = true break end
                task.wait(0.08)
            end
            if started then break end
        end

        if started then
            local t2 = os.clock()
            while S.autoThrow and ClientState and ClientState.Busy == "Throw" and os.clock() - t2 < 30 do
                task.wait(0.15)
            end
            local t3 = os.clock()
            while S.autoThrow and busy() and os.clock() - t3 < 10 do task.wait(0.1) end
            task.wait(0.25)
        else
            task.wait(0.8)
        end
    end
    R.throw = false
end

