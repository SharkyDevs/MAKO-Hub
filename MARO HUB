local function shortNum(n)
    local units = { {1e36,"Dd"},{1e33,"Dc"},{1e30,"No"},{1e27,"Oc"},{1e24,"Sp"},
                    {1e21,"Sx"},{1e18,"Qi"},{1e15,"Qa"},{1e12,"T"},{1e9,"B"},{1e6,"M"},{1e3,"K"} }
    for _, u in ipairs(units) do
        if n >= u[1] then return string.format("%.1f%s", n / u[1], u[2]) end
    end
    return tostring(math.floor(n))
end

local function ago(sec)
    if sec < 3600 then return math.max(1, math.floor(sec / 60)) .. "m ago" end
    if sec < 86400 then return math.floor(sec / 3600) .. "h ago" end
    return math.floor(sec / 86400) .. "d ago"
end

