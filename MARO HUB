local function ensurePastLine()
    local hrp = root()
    if not hrp then return false end
    local cl = crossLine()
    if cl then
        if hrp.Position.Z > cl.Position.Z - 1 then
            hrp.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y + 2, cl.Position.Z - 8)
            task.wait(0.07)
        end
    else
        hrp.CFrame = CFrame.new(0, 5.4, -42)
        task.wait(0.07)
    end
    pastLine = true
    return true
end

local function throwOnce()
    if os.clock() - lastThrow < cooldownEst then return false end
    if not pastLine then ensurePastLine() end

    local sres = invoke("Throw_Start")
    if not (okRes(sres) or sres == nil) then
        if type(sres) == "table" and sres.Reason == "Cooldown" then
            cooldownEst = math.min(cooldownEst + 0.15, 2.6)
        else
            pastLine = false
        end
        return false
    end

    local value = 1.0
    if not S.autoPerfect then value = math.random(45, 92) / 100 end

    local rres = invoke("Throw_Resolve", value)
    if not (okRes(rres) or rres == nil) then
        pastLine = false
        return false
    end

    invoke("Throw_Complete")
    lastThrow = os.clock()
    return true
end

local function startThrow()
    if R.throw then return end
    if not hasRemote("Throw_Start") then notify("Auto Throw", "Throw_Start missing", 4) return end
    R.throw = true
    hookController()
    pcall(invoke, "Player_SetThrowPower", 999999999)
    lastThrow = 0
    cooldownEst = 1.3
    task.spawn(function() ensurePastLine() end)

    task.spawn(function()
        while S.autoThrow and not unloaded do
            local remain = cooldownEst - (os.clock() - lastThrow)
            if remain > 0 then
                task.wait(math.min(remain, 0.12))
            else
                pcall(throwOnce)
                task.wait(S.throwDelay)
            end
        end
        R.throw = false
        unhookController()
        pastLine = false
    end)
end

