local function safeReq(inst)
    if not inst then return nil end
    local has = type(setthreadidentity) == "function"
    if has then pcall(setthreadidentity, 2) end
    local ok, v = pcall(require, inst)
    if has then pcall(setthreadidentity, 8) end
    if ok then return v end
end

