local oldStart
local function hookController()
    if oldStart or not ThrowController then return end
    if type(ThrowController.Start) ~= "function" then return end
    oldStart = ThrowController.Start
    ThrowController.Start = function(...)
        if S.autoThrow then return end
        return oldStart(...)
    end
end

local function unhookController()
    if not oldStart or not ThrowController then return end
    pcall(function() ThrowController.Start = oldStart end)
    oldStart = nil
end

