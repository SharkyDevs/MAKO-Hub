    if R.throw then return end
    R.throw = true
    installPerfect()
    if S.skipCutscene then installSkip() end
    pcall(invoke, "Player_SetThrowPower", 999999999)
    if not laneX then
        local hrp = root()
        if hrp then laneX = hrp.Position.X end
    end
    task.spawn(throwLoop)
