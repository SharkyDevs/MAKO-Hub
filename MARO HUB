local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes", 20)
local SharedRemotes

local function rObj(n) return RemotesFolder and RemotesFolder:FindFirstChild(n) or nil end

local function invoke(n, ...)
    local a = {...}
    local r = rObj(n)
    if r then
        local ok, res = pcall(function()
            if r:IsA("RemoteEvent") then return r:FireServer(unpack(a)) end
            return r:InvokeServer(unpack(a))
        end)
        if ok then return res end
    end
    if not SharedRemotes then
        local sh = ReplicatedStorage:FindFirstChild("Shared")
        local m = sh and sh:FindFirstChild("Remotes")
        if m then
            local ok, v = pcall(require, m)
            if ok then SharedRemotes = v end
        end
    end
    if SharedRemotes and type(SharedRemotes.Invoke) == "function" then
        local ok, res = pcall(function() return SharedRemotes.Invoke(n, unpack(a)) end)
        if ok then return res end
    end
    return nil
end

local function fire(n, ...)
    local a = {...}
    local r = rObj(n)
    if r then
        if r:IsA("RemoteEvent") then pcall(function() r:FireServer(unpack(a)) end)
        else pcall(function() r:InvokeServer(unpack(a)) end) end
    end
end

local hasRemote = function(n) return rObj(n) ~= nil end
